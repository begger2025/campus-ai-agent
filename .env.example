# 复制为 .env：copy .env.example .env

APP_HOST=127.0.0.1
APP_PORT=9000
DEBUG=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000
TIEBA_TIMEOUT=60
TIEBA_RETRIES=3

# 微博真实采集：二选一
# 1) 运行 save_weibo_login.bat 生成 data/cookies/weibo_state.json（推荐）
# 2) 或粘贴浏览器 Cookie（勿提交到 Git）
WEIBO_COOKIE=
WEIBO_KEYWORD=校园

# 贴吧真实采集：二选一（未登录会触发安全验证，采集 0 条）
# 1) 运行 save_tieba_login.bat 生成 data/cookies/tieba_state.json（推荐）
# 2) 或粘贴含 BDUSS 的 Cookie
TIEBA_COOKIE=
TIEBA_KEYWORD=大学生活
TIEBA_TIMEOUT=90
TIEBA_RETRIES=3
TIEBA_PLAYWRIGHT_TIMEOUT=90000

DATA_DIR=data

# --- Database (work package 0) ---
# Week 1 local only (do NOT use as team main DB in week 2):
# DATABASE_URL=sqlite:///data/campus.db
# SEED_DEMO_ON_START=true
#
# Week 2 work package 1 — shared MySQL (all teammates, SAME host):
DATABASE_URL=mysql+pymysql://campus_app:<password>@<db-host>:3306/campus_ai_agent?charset=utf8mb4
# Do not auto-insert demo when using run.bat (default off):
# SEED_DEMO_ON_START=false

# MediaCrawler project (separate repo) — same MySQL server, crawler account:
# MYSQL_DB_HOST=<db-host>
# MYSQL_DB_PORT=3306
# MYSQL_DB_USER=campus_crawler
# MYSQL_DB_PWD=<password>
# MYSQL_DB_NAME=campus_ai_agent

# --- Admin auth (work package 8) ---
# 首次启动时若不存在该管理员账号，后端会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_DISPLAY_NAME=管理员
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_EXPIRE_MINUTES=1440
# 演示普通用户（本地新库自动创建，ENSURE_DEMO_USER=false 可关闭）
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user123456

# --- 舆情排序：平台先验权重 (heat) ---
# 排序分 ranking_score = platform_weight[platform] × heat_rank（平台内百分位）。
# 展示给用户的仍是原始 heat_score，这里只影响排序/选 top-N。
# 默认权重：xhs 1.0 / ks 0.9 / web 0.8 / tieba 0.6 / zhihu 0.5 / weibo 0.4；未列出的平台 = 1.0。
# 调权重不需要迁移数据库、也不需要重跑归一化 pass——改这一行即可（增量覆盖，未写到的平台保持默认）。
# 两种写法都认；配置写坏会整体退回默认表。详见 docs/database.md。
# HEAT_PLATFORM_WEIGHTS={"weibo": 0.6, "zhihu": 0.7}
# HEAT_PLATFORM_WEIGHTS=weibo=0.6,zhihu=0.7

# --- 事件聚类的 LLM 精修 (docs/event-clustering-llm-refine.md) ---
# embedding 只看"像不像"，不看"是不是一件事"：297 条真实语料上它把 91 条帖子（31% 语料）
# 压成一个桶，并按词频 top-1 命名——桶里校区、作息争议、Vlog、讲座全混在一起。
# 精修把够大的簇交给 LLM 重新划分话题并起一个具体标题（禁止「…相关讨论」这种套话）。
# 缺省回落到 OPENAI_*；调用失败/未配 key 时自动退回纯 embedding 结果（不会拖垮流水线）。
EVENT_LLM_API_KEY=
EVENT_LLM_BASE_URL=
EVENT_LLM_MODEL=
# 0 = 关掉精修，回到纯 embedding 聚类。
EVENT_REFINE_ENABLED=true
# 多大的簇才值得一次 LLM 调用（默认 8：拆出两个事件至少要 2 × EVENT_MIN_CLUSTER_SIZE 条帖子，
# 且 8 正落在真实簇大小分布的缺口上——7 次调用覆盖 75% 语料）。
EVENT_REFINE_MIN_SIZE=8

# --- 事件级 LLM 风险研判 (docs/event-risk-llm.md) ---
# 复用上面同一组 EVENT_LLM_*。规则风险对"高风险"的全部认识只有六个电诈词
# （诈骗/银行卡/验证码/陌生人/尾随/缴费链接），认不出「宿舍火灾」；而评论数/转发数/热度
# 还在给风险加分，于是它量的是**流行度**不是**严重性**（实测：宿舍火灾 low/4.0 全库垫底，
# 学生吐槽作业多 medium/64.0 全库最高）。研判在**事件级**做（37 次调用，不是 297 次）。
# 0 = 关掉研判，回到规则风险；不关也会在超时/幻觉时逐事件自动退回规则值（不拖垮流水线）。
EVENT_RISK_ENABLED=true
# 一个事件最多送几条帖子给模型（严重性藏在少数几条帖子里，读完 91 条纯属烧钱）。
EVENT_RISK_MAX_TEXTS=20

# --- 事件时效性衰减 (docs/event-recency.md) ---
# 平台的立身之本是"呈现**近期**舆情"，但改造前整条流水线**时间盲**：热度、风险、排序没有
# 一处看过 publish_time。实测后果：已发布事件「中大学生诽谤被开除」是 high/90.0、排进前三，
# 而它的两条帖子发于 2021-06-18（1849 天前）——五年前的处分被当成今天的新闻推给用户。
#
# 时效权重 = 0.5 ** (事件年龄天数 / 半衰期)，纯算术、可解释、零 LLM 调用
# （「107 天前、半衰期 30 天 -> 0.5^(107/30) = 0.084」答辩答得出；「模型觉得它不够新」答不出）。
# 它**只进排序**：risk_level/risk_score（严重性）和 heat_score（实测热度）一个字节都不改
# ——宿舍火灾不会因为过了三个月就变得不严重。
#
# 半衰期（天）。默认 21：真实事件的成员帖跨度在 42 天量级，半衰期取其一半 ⇒ 仍在持续发帖的
# 事件在活跃期内保住 ≥0.5 权重，停更两三周就掉出首屏。刻度：7 天 0.79 / 21 天 0.50 /
# 42 天 0.25 / 90 天 0.05 / 一年 6e-6。<= 0 表示**关掉衰减**（消融对照臂 / 应急开关）。
EVENT_RECENCY_HALF_LIFE_DAYS=21
# 权重地板（防下溢，不是语义阈值）：1e-6 ≈ 20 个半衰期 ≈ 14 个月。保证权重永远 > 0，
# 陈旧事件之间的顺序不会因为整列塌成 0 而变成随机；地板之下按严重性/热度排。
EVENT_RECENCY_MIN_WEIGHT=0.000001
# 事件的代表时间取成员帖的哪一个：median（默认）| latest。
# latest 会被**一条**掉队的新帖劫持（今天有人转发一句五年前的旧事，整个事件就"变新"了）
# ——而这正是要修的失败模式。median 要过半成员是新的才前移；代价是正在发酵的事件略滞后，
# 但两种错误的代价不对称：晚一天推新事件只损失及时性，把五年前的处分当新闻推损失的是可信度。
EVENT_RECENCY_TIMESTAMP=median

# --- 事件状态研判：生命周期 (docs/event-lifecycle.md) ---
# 复用上面同一组 EVENT_LLM_*（读的是同一批成员帖，只是问题不同，条数也复用 EVENT_RISK_MAX_TEXTS）。
# 时效衰减只认年龄，可年龄分不出这两件事：「东校区宿舍火情」（3.5 个月前，火已扑灭、校方已通报、
# 无人员伤亡、调查已立案 —— **事情结束了**）和「中大杰青实名举报」（2.2 个月前，调查无结论 ——
# **口子还开着**）。「已了结 vs 悬而未决」是对**内容**的判断：时间戳答不了（停更既可能是解决了、
# 也可能是没人管了），关键词也答不了（"通报"既出现在"校方已通报结果"里，也出现在"至今未见通报"里）。
#
# 排序键 = severity_weight(risk_level) × recency_weight × lifecycle_weight(lifecycle)
# lifecycle_weight = {escalating: 4, ongoing: 2, resolved: 0.5, 未研判: 1.0}
# 因子是 2 的幂，所以能用半衰期读：×2 ⇔ 把事件当作年轻了一个半衰期（21 天），×0.5 ⇔ 当作老了一个。
# 整根轴的动态范围 8× < 严重性的 9×：「持续发酵的低风险」压不过「已了结的高风险」（不是后门）。
# false = 关掉研判 -> 所有事件"未研判" -> 因子恒 1.0 -> 排序逐位退化回改造前；
# 不关也会在超时/幻觉时**逐事件**退回"未研判"（不拖垮流水线，降级记进 agent_run_logs）。
EVENT_LIFECYCLE_ENABLED=true

# --- Evidence collector (证据采集) ---
# 证据采集复用 backend 的 DATABASE_URL 与 JWT 鉴权，不需要单独的库地址或 token。
# 一个 provider 只有在 API_KEY / MODEL / BASE_URL / WEB_SEARCH_ENABLED=true 四者齐备时才会启用
# （GLM 例外：它的检索接口不接受 model，见下）。
# 勿提交真实密钥。
EVIDENCE_DEEPSEEK_API_KEY=
EVIDENCE_DEEPSEEK_MODEL=deepseek-chat
EVIDENCE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
EVIDENCE_DEEPSEEK_WEB_SEARCH_ENABLED=false

# 智谱 GLM 走的是「独立检索接口」web_search，不是 chat 接口：
# 请求体只有 {"search_engine", "search_query"}，因此 EVIDENCE_GLM_MODEL 不再需要
# （即使配置了也会被忽略），GLM 只要 API_KEY / BASE_URL / WEB_SEARCH_ENABLED 三者齐备即可启用。
# 引用直接来自搜索引擎索引而非模型生成的文本，所以不可能出现编造的来源 URL。
EVIDENCE_GLM_API_KEY=
EVIDENCE_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/web_search
EVIDENCE_GLM_WEB_SEARCH_ENABLED=false
# 检索引擎档位，默认 search_pro_bing。
# 注意：基础档位 search_std / search_pro 返回的结果 link 全为空——没有来源 URL，
# 无法做可审计证据，故不可用；只能用 search_pro_* 档位
# （search_pro_bing / search_pro_jina / search_pro_sogou / search_pro_quark），
# 它们按次计费且单价更高。
EVIDENCE_GLM_SEARCH_ENGINE=search_pro_bing

EVIDENCE_KIMI_API_KEY=
EVIDENCE_KIMI_MODEL=moonshot-v1-8k
EVIDENCE_KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
EVIDENCE_KIMI_WEB_SEARCH_ENABLED=false

EVIDENCE_DOUBAO_API_KEY=
EVIDENCE_DOUBAO_MODEL=<doubao-endpoint-id>
EVIDENCE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
EVIDENCE_DOUBAO_WEB_SEARCH_ENABLED=false

EVIDENCE_QWEN_API_KEY=
EVIDENCE_QWEN_MODEL=qwen-plus
EVIDENCE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
EVIDENCE_QWEN_WEB_SEARCH_ENABLED=false

# 域名白名单（逗号分隔，留空则用代码内置默认值）
# EVIDENCE_SYSU_OFFICIAL_DOMAINS=sysu.edu.cn,news.sysu.edu.cn
# EVIDENCE_ALLOWED_NEWS_DOMAINS=people.com.cn,xinhuanet.com

# 证据侧 HTTP 客户端是否继承环境/系统代理。默认 false = 直连。
# httpx 默认会读 Windows 注册表里的系统代理（Clash 写在那里），导致抓取真实可达的
# xxgk.sysu.edu.cn 超时、真证据被误判。只有确实必须走代理才能上网时才设为 true。
# EVIDENCE_HTTP_TRUST_ENV=false
