# 复制为 .env：copy .env.example .env

APP_HOST=127.0.0.1
APP_PORT=9000
DEBUG=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000
TIEBA_TIMEOUT=60
TIEBA_RETRIES=3

# 微博真实采集：二选一
# 1) 运行 save_weibo_login.bat 生成 data/cookies/weibo_state.json（推荐）
# 2) 或粘贴浏览器 Cookie（勿提交到 Git）
WEIBO_COOKIE=
WEIBO_KEYWORD=校园

# 贴吧真实采集：二选一（未登录会触发安全验证，采集 0 条）
# 1) 运行 save_tieba_login.bat 生成 data/cookies/tieba_state.json（推荐）
# 2) 或粘贴含 BDUSS 的 Cookie
TIEBA_COOKIE=
TIEBA_KEYWORD=大学生活
TIEBA_TIMEOUT=90
TIEBA_RETRIES=3
TIEBA_PLAYWRIGHT_TIMEOUT=90000

DATA_DIR=data

# --- Database (work package 0) ---
# Week 1 local only (do NOT use as team main DB in week 2):
# DATABASE_URL=sqlite:///data/campus.db
# SEED_DEMO_ON_START=true
#
# Week 2 work package 1 — shared MySQL (all teammates, SAME host):
DATABASE_URL=mysql+pymysql://campus_app:<password>@<db-host>:3306/campus_ai_agent?charset=utf8mb4
# Do not auto-insert demo when using run.bat (default off):
# SEED_DEMO_ON_START=false

# MediaCrawler project (separate repo) — same MySQL server, crawler account:
# MYSQL_DB_HOST=<db-host>
# MYSQL_DB_PORT=3306
# MYSQL_DB_USER=campus_crawler
# MYSQL_DB_PWD=<password>
# MYSQL_DB_NAME=campus_ai_agent

# --- Admin auth (work package 8) ---
# 首次启动时若不存在该管理员账号，后端会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_DISPLAY_NAME=管理员
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_EXPIRE_MINUTES=1440
# 演示普通用户（本地新库自动创建，ENSURE_DEMO_USER=false 可关闭）
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user123456

# --- Evidence collector (证据采集) ---
# 证据采集复用 backend 的 DATABASE_URL 与 JWT 鉴权，不需要单独的库地址或 token。
# 一个 provider 只有在 API_KEY / MODEL / BASE_URL / WEB_SEARCH_ENABLED=true 四者齐备时才会启用。
# 勿提交真实密钥。
EVIDENCE_DEEPSEEK_API_KEY=
EVIDENCE_DEEPSEEK_MODEL=deepseek-chat
EVIDENCE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
EVIDENCE_DEEPSEEK_WEB_SEARCH_ENABLED=false

EVIDENCE_GLM_API_KEY=
EVIDENCE_GLM_MODEL=glm-4
EVIDENCE_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
EVIDENCE_GLM_WEB_SEARCH_ENABLED=false

EVIDENCE_KIMI_API_KEY=
EVIDENCE_KIMI_MODEL=moonshot-v1-8k
EVIDENCE_KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
EVIDENCE_KIMI_WEB_SEARCH_ENABLED=false

EVIDENCE_DOUBAO_API_KEY=
EVIDENCE_DOUBAO_MODEL=<doubao-endpoint-id>
EVIDENCE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
EVIDENCE_DOUBAO_WEB_SEARCH_ENABLED=false

EVIDENCE_QWEN_API_KEY=
EVIDENCE_QWEN_MODEL=qwen-plus
EVIDENCE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
EVIDENCE_QWEN_WEB_SEARCH_ENABLED=false

# 域名白名单（逗号分隔，留空则用代码内置默认值）
# EVIDENCE_SYSU_OFFICIAL_DOMAINS=sysu.edu.cn,news.sysu.edu.cn
# EVIDENCE_ALLOWED_NEWS_DOMAINS=people.com.cn,xinhuanet.com
