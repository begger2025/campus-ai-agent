# 复制为 .env：copy .env.example .env

APP_HOST=127.0.0.1
APP_PORT=9000
DEBUG=false

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000
TIEBA_TIMEOUT=60
TIEBA_RETRIES=3

# 微博真实采集：二选一
# 1) 运行 scripts/save_weibo_login.py 生成 data/cookies/weibo_state.json（推荐）
# 2) 或粘贴浏览器 Cookie（勿提交到 Git）
WEIBO_COOKIE=
WEIBO_KEYWORD=校园
TIEBA_KEYWORD=大学生活

DATA_DIR=data
DATABASE_URL=sqlite:///data/campus.db
