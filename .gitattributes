# 统一行尾，避免跨平台协作时的 CRLF/LF 噪声与线上脚本 bad interpreter 报错。

# 默认：文本文件由 git 自动规范化，仓库内存 LF
* text=auto

# 要在 Linux 服务器执行的脚本/配置：强制 LF（CRLF 会让 bash 报 \r bad interpreter）
*.sh          text eol=lf
deploy/*      text eol=lf
*.service     text eol=lf
*.conf        text eol=lf

# Windows 批处理保持 CRLF
*.bat         text eol=crlf
*.ps1         text eol=crlf

# 二进制/资源：不做行尾转换
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.npz         binary
*.ttf         binary
*.woff        binary
*.woff2       binary
